# ── Auth Microservice Environment ─────────────────────────────────────────────
# Copy this file to .env for local development:
#   cp .env.example .env
# Production values are injected via docker-compose.yml / docker-stack.yml.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Database
# Option A — a single connection string (takes precedence if set):
#   DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_URL=
#
# Option B — the individual parts (used only when DATABASE_URL is not set):
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=devops
DB_PASSWORD=devops123
DB_DATABASE=devops_auth
DB_SYNCHRONIZE=true
# TLS — required by most managed Postgres (RDS/Neon/Supabase). Applies to both
# options above, since a URL's sslmode is overridden by the app's ssl setting:
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT — access token (short-lived, used by every API request)
# Use a strong random string in production: openssl rand -hex 32
JWT_SECRET=changeme-use-strong-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m

# JWT — refresh token (long-lived, stored as bcrypt hash in DB)
# Must be DIFFERENT from JWT_SECRET
JWT_REFRESH_SECRET=changeme-use-different-secret-min-32-chars
JWT_REFRESH_EXPIRY=7d
