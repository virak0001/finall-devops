# Secrets for the compose stack.
#
#   cp docker/.env.example docker/.env
#   $EDITOR docker/.env
#   make deploy
#
# docker/.env is gitignored; this template is not, so it must never hold a
# real credential.
#
# Format is literal — everything after the first = is the value. No quotes,
# no export, no trailing comments on a value line.

# Postgres password for SonarQube. Any long random string; nothing else reads
# it, and changing it after first boot means SonarQube can no longer open its
# own database.
#
#   openssl rand -base64 24
SONAR_DB_PASSWORD=

# What Jenkins believes its own address is. Used in links it generates and in
# webhook callbacks. make deploy overwrites this with the Elastic IP, so it
# only matters if you run compose by hand.
JENKINS_URL=

# ─── Jenkins credentials ─────────────────────────────────────────────────────
# Created in Jenkins on every start by init.groovy.d/10-credentials.groovy.
# Leave one blank and that credential is skipped rather than created empty.

# Git over HTTPS. The token goes in GIT_TOKEN and Jenkins stores it as the
# password; GitHub largely ignores the username but it must not be blank.
#   GitHub  Settings > Developer settings > Personal access tokens
#           scope: repo  (plus read:packages if you pull from GHCR)
GIT_USERNAME=
GIT_TOKEN=
GIT_CREDENTIALS_ID=git-token

# SonarQube. Generate a USER token, not a project-analysis one — a project
# token analyses fine but silently fails the quality-gate webhook callback.
#   SonarQube > My Account > Security > Generate Token
SONAR_TOKEN=
SONAR_CREDENTIALS_ID=sonar-token

# SonarQube token for the employee-service pipeline. Same rule as SONAR_TOKEN
# above: a USER token if this pipeline waits on the quality gate, otherwise a
# project-analysis token is fine.
SONAR_EMPLOYEE_SERVICE_TOKEN=
SONAR_EMPLOYEE_SERVICE_CREDENTIALS_ID=sonar-employee-service-token

# SonarQube token for the auth-service pipeline. Same rule as SONAR_TOKEN.
SONAR_AUTH_SERVICE_TOKEN=
SONAR_AUTH_SERVICE_CREDENTIALS_ID=sonar-auth-service-token

# SonarQube token for the core-service pipeline. Same rule as SONAR_TOKEN.
SONAR_CORE_SERVICE_TOKEN=
SONAR_CORE_SERVICE_CREDENTIALS_ID=sonar-core-service-token

# Telegram build notifications. usernamePassword credential: username=chat_id,
# password=bot token.
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CREDENTIALS_ID=telegram-notify

# ─── Platform pipelines ──────────────────────────────────────────────────────

# Write access to the cluster (GitOps) repository, and nothing else — the
# pipelines commit image tags there. GitHub fine-grained token: repository
# access = the cluster repo only, permission = Contents: read and write.
GITOPS_USERNAME=
GITOPS_TOKEN=

# Argo CD `ci` account tokens, one per environment. In the cluster project:
#   make argocd-ci-token WORKSPACE=dev
ARGOCD_TOKEN_DEV=
ARGOCD_TOKEN_UAT=
ARGOCD_TOKEN_PROD=

# Shared with GitHub by `make webhooks`; Jenkins rejects any delivery not
# signed with it.
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Where the shared library is fetched from (init.groovy.d/30). Defaults to
# this repository's master branch.
# PLATFORM_LIBRARY_REPO=https://github.com/devops-infra-virak-ran/jenkins-sonarqube.git
# PLATFORM_LIBRARY_BRANCH=master
